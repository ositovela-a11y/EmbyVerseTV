# Copia como keystore.properties (no se versiona) para firmar el APK de producción.
# Crea la clave con:  keytool -genkeypair -v -keystore embyverse-release.jks -keyalg RSA -keysize 4096 -validity 10000 -alias embyverse
storeFile=../embyverse-release.jks
storePassword=CAMBIA_ESTO
keyAlias=embyverse
keyPassword=CAMBIA_ESTO
