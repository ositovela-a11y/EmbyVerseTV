{
  "name": "embyverse-backend",
  "version": "1.0.0",
  "private": true,
  "description": "API de EmbyVerse: configuración visual remota, banners, imágenes, usuarios del panel y auditoría.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": { "node": ">=22.13" },
  "main": "dist/src/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node --disable-warning=ExperimentalWarning dist/src/server.js",
    "cli": "node --disable-warning=ExperimentalWarning dist/src/cli.js",
    "test": "npm run build && node --disable-warning=ExperimentalWarning --test --test-reporter=spec \"dist/test/**/*.test.js\"",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.9.0"
  }
}
