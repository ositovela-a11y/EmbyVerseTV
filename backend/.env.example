# Copia como .env (no se versiona) o define estas variables en tu servicio de hosting.
NODE_ENV=production
PORT=8080
HOST=0.0.0.0
# URL pública HTTPS por la que la app y el panel llegan a este servidor (obligatoria en producción).
PUBLIC_BASE_URL=https://config.tu-dominio.com
DATA_DIR=/var/lib/embyverse
# Detrás de un proxy inverso (Caddy, Nginx, Cloudflare) para leer la IP real y el protocolo.
TRUST_PROXY=true
COOKIE_SECURE=true
# Hosts externos permitidos para imágenes de banners (opcional, separados por comas).
ALLOWED_IMAGE_HOSTS=
# Solo para el primer arranque: crea el propietario y después BORRA estas dos líneas.
ADMIN_EMAIL=
ADMIN_PASSWORD=
